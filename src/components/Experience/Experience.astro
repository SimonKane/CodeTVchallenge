---
import Hero from "../Hero/Hero.astro";
import childImage from "./assets/child.webp";
import streetImage from "../Hero/assets/street.webp";
import childLookbackImage from "./assets/child-lookback.webp";
import hushImage from "./assets/schh.webp";
import depthImage from "./assets/street-depth.png";
import closedUmbrellaImage from "./assets/closed-umbrella.webp";
import openUmbrellaImage from "./assets/open-umbrella.webp";
import withoutHoodImage from "./assets/whitout-hood.webp";
import "./Experience.css";

const hiddenMessage = "tystnad";
---

<section
  class="experience"
  data-cinematic-scene
  data-scene-status="loading"
  aria-labelledby="experience-title"
  aria-describedby="experience-eyebrow"
>
  <div class="experience-stage" data-experience-stage>
    <canvas
      class="experience-canvas"
      data-experience-canvas
      data-street-src={streetImage.src}
      data-depth-src={depthImage.src}
      data-child-src={childImage.src}
      data-child-lookback-src={childLookbackImage.src}
      aria-hidden="true"
    ></canvas>
    <div class="experience-copy" data-experience-copy>
      <p id="experience-eyebrow" class="experience-eyebrow">
        När ett barn far illa
      </p>
      <h1 id="experience-title" class="experience-title">
        <span data-title-first>Våga</span>
        <span data-title-second>se.</span>
      </h1>
    </div>

  </div>
</section>

<div class="experience-fallback" data-experience-fallback hidden>
  <Hero />
</div>

<section
  class="experience-chapter"
  data-experience-chapter
  aria-labelledby="experience-chapter-title"
  style={`--chapter-background: url(${streetImage.src})`}
>
  <div
    class="experience-transition-flash"
    data-transition-flash
    aria-hidden="true"
  >
    <svg viewBox="0 0 1000 500" preserveAspectRatio="none">
      <path
        pathLength="1"
        d="M935 -20 L914 20 L920 48 L891 78 L898 105 L867 137 L872 164 L841 194 L847 219 L816 250 L821 275 L789 307 L795 332 L763 365 L768 391 L735 423 L740 448 L706 520"
      />
      <path
        pathLength="1"
        d="M872 164 L835 147 L806 119 L774 111"
      />
      <path
        pathLength="1"
        d="M795 332 L755 317 L725 289 L689 279"
      />
    </svg>
  </div>
  <div class="experience-chapter-child" data-chapter-child aria-hidden="true">
    <img src={childLookbackImage.src} alt="" decoding="async" />
  </div>
  <div
    class="editorial-final-image"
    data-editorial-final-image
    aria-hidden="true"
  >
    <img src={hushImage.src} alt="" decoding="async" />
  </div>
  <div
    class="editorial-hidden-message"
    data-editorial-hidden-message
    aria-hidden="true"
  >
    <div class="editorial-hidden-word" data-editorial-hidden-word>
      {
        [...hiddenMessage].map((letter) => (
          <span data-editorial-target-letter>{letter}</span>
        ))
      }
    </div>
    <p>Tystnaden skyddar inte barnet.</p>
  </div>
  <canvas
    class="editorial-lightning"
    data-editorial-lightning
    aria-hidden="true"
  ></canvas>
  <div
    class="editorial-lightning-exposure"
    data-editorial-lightning-exposure
    aria-hidden="true"
  ></div>
  <div class="experience-chapter-copy" data-chapter-copy>
    <p
      class="experience-chapter-eyebrow"
      data-chapter-eyebrow
      aria-label="PARAPLY"
    >
      PARAPLY
    </p>
    <h2 id="experience-chapter-title" aria-label="Alla sår syns inte.">
      <span class="experience-chapter-line-mask">
        <span data-chapter-line aria-hidden="true">Alla sår</span>
      </span>
      <span class="experience-chapter-line-mask">
        <span data-chapter-line aria-hidden="true">syns inte.</span>
      </span>
    </h2>
    <p
      class="experience-chapter-body"
      data-chapter-body
      aria-label="Paraply arbetar för en tryggare värld fri från sexuella övergrepp mot barn. Genom kunskap, stöd och modet att agera kan fler barn bli sedda."
    >
      <span data-chapter-body-line aria-hidden="true"
        >Paraply arbetar för en tryggare värld fri från</span
      >
      <span data-chapter-body-line aria-hidden="true"
        >sexuella övergrepp mot barn. Genom kunskap, stöd</span
      >
      <span data-chapter-body-line aria-hidden="true"
        >och modet att agera kan fler barn bli sedda.</span
      >
    </p>
  </div>

<div
  class="umbrella-chapter"
  data-umbrella-chapter
  role="region"
  aria-labelledby="umbrella-safe-title"
>
  <div class="umbrella-chapter__stage" data-umbrella-stage>
    <div class="umbrella-chapter__media" aria-hidden="true">
      <img
        class="umbrella-chapter__image umbrella-chapter__image--closed"
        data-umbrella-closed
        src={closedUmbrellaImage.src}
        alt=""
        decoding="async"
      />
      <img
        class="umbrella-chapter__sheltered-child"
        data-umbrella-sheltered-child
        src={withoutHoodImage.src}
        alt=""
        decoding="async"
      />
      <img
        class="umbrella-chapter__image umbrella-chapter__image--open"
        data-umbrella-open
        src={openUmbrellaImage.src}
        alt=""
        decoding="async"
      />
      <canvas
        class="umbrella-chapter__canopy-rain"
        data-umbrella-canopy-rain
        aria-hidden="true"
      ></canvas>
    </div>

    <div
      class="umbrella-chapter__problem"
      data-umbrella-problem
      aria-label="Idag utsätts 1 av 3 barn i Sverige någon gång för sexuellt våld. Paraply arbetar för att minska dessa förödande siffror, men för att skapa förändring behöver vi tillsammans våga se problemet och aktivt ta ställning emot det. Vi vågar, vågar du?"
    >
      <p class="umbrella-chapter__stat" data-umbrella-rain-text>
        Idag utsätts <strong>1 av 3 barn</strong> i Sverige någon gång för
        sexuellt våld.
      </p>
      <p class="umbrella-chapter__action" data-umbrella-rain-text>
        Paraply arbetar för att minska dessa förödande siffror, men för att
        skapa förändring behöver vi <strong>tillsammans</strong> våga se
        problemet och <strong>aktivt</strong> ta ställning emot det.
      </p>
      <p class="umbrella-chapter__challenge" data-umbrella-rain-text>
        Vi vågar, vågar du?
      </p>
    </div>

    <div class="umbrella-chapter__shelter-glow" data-umbrella-glow aria-hidden="true">
    </div>
    <div class="umbrella-chapter__safe-copy" data-umbrella-safe>
      <h2 id="umbrella-safe-title">Välkommen till en trygg plats!</h2>
      <p>
        Vi på Paraply förstår att ett övergrepp kan leda till en mängd olika
        känslor, tankar och reaktioner hos dig som blivit utsatt. Därför finns
        vi här för dig som behöver någon att prata med.
      </p>
      <p>
        Hos oss kan du vara anonym, vi tar din integritet på största allvar och
        alla våra samtal och chattar är konfidentiella.
      </p>
      <p class="umbrella-chapter__safe-final">Vi finns här för dig.</p>
    </div>

    <div
      class="umbrella-chapter__exposure"
      data-umbrella-exposure
      aria-hidden="true"
    ></div>
  </div>
</div>
</section>

<script>
  import "./Experience.ts";
</script>
