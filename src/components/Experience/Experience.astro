---
import Hero from "../Hero/Hero.astro";
import childImage from "./assets/child.png";
import streetImage from "../Hero/assets/street.png";
import childLookbackImage from "./assets/child-lookback.png";
import hushImage from "./assets/schh.png";
import depthImage from "./assets/street-depth.png";
import "./Experience.css";

const hiddenMessage = "tystnad";
---

<section
  class="experience"
  data-cinematic-scene
  data-scene-status="loading"
  aria-labelledby="experience-title"
  aria-describedby="experience-eyebrow"
>
  <div class="experience-stage" data-experience-stage>
    <canvas
      class="experience-canvas"
      data-experience-canvas
      data-street-src={streetImage.src}
      data-depth-src={depthImage.src}
      data-child-src={childImage.src}
      data-child-lookback-src={childLookbackImage.src}
      aria-hidden="true"
    ></canvas>
    <div class="experience-copy" data-experience-copy>
      <p id="experience-eyebrow" class="experience-eyebrow">
        När ett barn far illa
      </p>
      <h1 id="experience-title" class="experience-title">
        <span data-title-first>Våga</span>
        <span data-title-second>se.</span>
      </h1>
    </div>

  </div>
</section>

<div class="experience-fallback" data-experience-fallback hidden>
  <Hero />
</div>

<section
  class="experience-chapter"
  data-experience-chapter
  aria-labelledby="experience-chapter-title"
  style={`--chapter-background: url(${streetImage.src})`}
>
  <div
    class="experience-transition-flash"
    data-transition-flash
    aria-hidden="true"
  >
    <svg viewBox="0 0 1000 500" preserveAspectRatio="none">
      <path
        pathLength="1"
        d="M935 -20 L914 20 L920 48 L891 78 L898 105 L867 137 L872 164 L841 194 L847 219 L816 250 L821 275 L789 307 L795 332 L763 365 L768 391 L735 423 L740 448 L706 520"
      />
      <path
        pathLength="1"
        d="M872 164 L835 147 L806 119 L774 111"
      />
      <path
        pathLength="1"
        d="M795 332 L755 317 L725 289 L689 279"
      />
    </svg>
  </div>
  <div class="experience-chapter-child" data-chapter-child aria-hidden="true">
    <img src={childLookbackImage.src} alt="" />
  </div>
  <div
    class="editorial-final-image"
    data-editorial-final-image
    aria-hidden="true"
  >
    <img src={hushImage.src} alt="" />
  </div>
  <div
    class="editorial-hidden-message"
    data-editorial-hidden-message
    aria-hidden="true"
  >
    <div class="editorial-hidden-word" data-editorial-hidden-word>
      {
        [...hiddenMessage].map((letter) => (
          <span data-editorial-target-letter>{letter}</span>
        ))
      }
    </div>
    <p>Tystnaden skyddar inte barnet.</p>
  </div>
  <canvas
    class="editorial-lightning"
    data-editorial-lightning
    aria-hidden="true"
  ></canvas>
  <div
    class="editorial-lightning-exposure"
    data-editorial-lightning-exposure
    aria-hidden="true"
  ></div>
  <div class="experience-chapter-copy" data-chapter-copy>
    <p
      class="experience-chapter-eyebrow"
      data-chapter-eyebrow
      aria-label="PARAPLY"
    >
      PARAPLY
    </p>
    <h2 id="experience-chapter-title" aria-label="Alla sår syns inte.">
      <span class="experience-chapter-line-mask">
        <span data-chapter-line aria-hidden="true">Alla sår</span>
      </span>
      <span class="experience-chapter-line-mask">
        <span data-chapter-line aria-hidden="true">syns inte.</span>
      </span>
    </h2>
    <p
      class="experience-chapter-body"
      data-chapter-body
      aria-label="Paraply arbetar för en tryggare värld fri från sexuella övergrepp mot barn. Genom kunskap, stöd och modet att agera kan fler barn bli sedda."
    >
      <span data-chapter-body-line aria-hidden="true"
        >Paraply arbetar för en tryggare värld fri från</span
      >
      <span data-chapter-body-line aria-hidden="true"
        >sexuella övergrepp mot barn. Genom kunskap, stöd</span
      >
      <span data-chapter-body-line aria-hidden="true"
        >och modet att agera kan fler barn bli sedda.</span
      >
    </p>
  </div>
</section>

<script>
  import "./Experience.ts";
</script>
