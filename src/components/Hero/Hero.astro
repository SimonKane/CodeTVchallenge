---
import './Hero.css';
import streetImage from './assets/street.png';
import childImage from './assets/child.png';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-scene">
		<img
			class="hero-street"
			src={streetImage.src}
			alt=""
			aria-hidden="true"
		/>

		<div class="hero-child-positioner">
			<div class="hero-child-awareness">
				<img
					class="hero-child"
					src={childImage.src}
					alt=""
					aria-hidden="true"
				/>
			</div>
		</div>

		<div class="hero-darkness" aria-hidden="true"></div>

		<div class="hero-flash" aria-hidden="true"></div>

		<div class="hero-copy">
			<p class="hero-eyebrow">When a child is being harmed</p>

			<h1 id="hero-title" class="hero-title">
				<span class="hero-title-word hero-title-word--first">Dare</span><span
					class="hero-title-word hero-title-word--second">to see.</span
				>
			</h1>
		</div>
	</div>
</section>

<script>
	import './Hero.ts';
</script>
